# Copy this file to .env.local on the computer that will act as the local POS server.
# Keep this file private. Do not commit real values.
NODE_ENV=production
DEPLOYMENT_MODE=onprem
PORT=4028
HOSTNAME=0.0.0.0

# PostgreSQL running on this same computer.
DATABASE_URL=postgresql://tovapos_app:replace-with-a-local-password@127.0.0.1:5432/tovapos_local
NEXT_PUBLIC_STORAGE_DRIVER=postgres
NEXT_PUBLIC_DEPLOYMENT_MODE=onprem
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:4028
NEXT_PUBLIC_APP_URL=http://127.0.0.1:4028

# Local installations do not depend on cloud email delivery.
PASSWORD_RESET_DEV_LINKS=false
AUTH_DEV_LINKS=false

# Keep pool size appropriate for the local machine.
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_QUERY_TIMEOUT_MS=20000

ONPREM_BACKUP_DIR=./backups
